{
    "name": "kimibuilt",
    "version": "1.0.0",
    "description": "Multi-interface AI backend with contextual memory — CLI, Web Chat, Canvas, and Notation Helper",
    "main": "src/server.js",
    "engines": {
        "node": ">=24 <25"
    },
    "bin": {
        "kimibuilt-ingress": "bin/kimibuilt-ingress.js",
        "lilly-game": "bin/lilly-game.js",
        "kimibuilt-runner": "bin/kimibuilt-runner.js",
        "kimibuilt-symphony": "bin/kimibuilt-symphony.js",
        "kimibuilt-ui-check": "bin/kimibuilt-ui-check.js"
    },
    "scripts": {
        "start": "node src/server.js",
        "build:lilly-engine": "tsc -p packages/lilly-engine/tsconfig.json && tsc -p packages/lilly-engine/tsconfig.browser.json",
        "build:game-studio": "vite build --config frontend/game-studio/vite.config.ts",
        "build:game-studio:all": "npm run build:lilly-engine && npm run build:game-studio",
        "dev:game-studio": "vite --config frontend/game-studio/vite.config.ts",
        "smoke:game-studio": "node bin/lilly-game-studio-smoke.js",
        "game": "node bin/lilly-game.js",
        "test:game-studio": "npm run build:lilly-engine && jest --runInBand --runTestsByPath packages/lilly-engine/core/src/index.test.js packages/lilly-engine/blueprints/src/index.test.js packages/lilly-engine/gameplay/src/index.test.js packages/lilly-engine/modules/src/index.test.js src/game-studio/cli-client.test.js src/game-studio/service.test.js src/routes/game-studio.test.js src/orchestration/agent-roles.test.js src/routes/canvas.test.js src/tool-execution-profiles.test.js",
        "ingress": "node bin/kimibuilt-ingress.js",
        "runner": "node bin/kimibuilt-runner.js",
        "dev": "nodemon src/server.js",
        "test": "jest --coverage",
        "test:async-lab": "jest --coverage --runInBand src/async-lab/service.test.js src/routes/async-lab.test.js",
        "test:async-lab:valkey": "jest --runInBand src/async-lab/valkey-live-bus.integration.test.js",
        "perf:frontend-load": "node bin/kimibuilt-frontend-load-check.js",
        "test:load": "node scripts/load-release-gate.js",
        "test:intelligence": "jest --runInBand src/session-scope.test.js src/perceived-intelligence-harness.test.js src/memory/memory-service.test.js src/conversation-orchestrator.test.js",
        "eval:agent-runs": "node scripts/agent-eval-gate.js",
        "eval:agent-runs:self-check": "node scripts/agent-eval-gate.js --self-check",
        "replay:agent-runs": "node scripts/agent-replay-check.js",
        "demo:preflight": "node scripts/demo-preflight.js",
        "demo:preflight:offline": "node scripts/demo-preflight.js --offline",
        "demo:smoke": "node scripts/demo-smoke.js",
        "demo:smoke:live": "node scripts/demo-smoke.js --live",
        "canary:remote-agent-artifact-loop": "node scripts/canary-remote-agent-artifact-loop.js",
        "canary:remote-agent-authoring": "node scripts/canary-remote-agent-artifact-loop.js --authoring",
        "canary:sandbox-agent-attach": "node scripts/canary-sandbox-agent-attach.js",
        "test:canary:sandbox-agent-attach": "jest --runInBand scripts/canary-sandbox-agent-attach.test.js",
        "test:watch": "jest --watch",
        "lint": "eslint src/",
        "release:bundle": "node suite/scripts/build-release-bundle.mjs",
        "release:gate": "node suite/scripts/release-gate.mjs",
        "release:package": "node suite/scripts/build-release-bundle.mjs && node suite/scripts/release-gate.mjs",
        "docker:build": "docker buildx build --platform linux/amd64,linux/arm64 --target media --build-arg INSTALL_NPM_OPTIONAL=true -t ghcr.io/philly1084/kimibuilt:latest .",
        "docker:build:async-lab": "docker buildx build --platform linux/amd64,linux/arm64 --target lite --build-arg INSTALL_NPM_OPTIONAL=true -t ghcr.io/philly1084/lilly:async-lab .",
        "docker:push": "docker buildx build --platform linux/amd64,linux/arm64 --target media --build-arg INSTALL_NPM_OPTIONAL=true -t ghcr.io/philly1084/kimibuilt:latest --push .",
        "license:gate": "node scripts/license-release-gate.js",
        "k8s:apply": "kubectl apply -f k8s/",
        "k8s:delete": "kubectl delete -f k8s/",
        "k8s:setup-remote-cli-agent": "powershell -ExecutionPolicy Bypass -File k8s/setup-remote-cli-agent.ps1"
    },
    "keywords": [
        "ai",
        "openai",
        "qdrant",
        "ollama",
        "chat",
        "canvas",
        "notation"
    ],
    "license": "MIT",
    "dependencies": {
        "@dimforge/rapier3d-compat": "^0.19.0",
        "@highlightjs/cdn-assets": "11.9.0",
        "@huggingface/transformers": "^3.8.1",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@monaco-editor/react": "^4.7.0",
        "@mozilla/readability": "^0.6.0",
        "@openai/agents": "^0.8.5",
        "@qdrant/js-client-rest": "^1.12.0",
        "@react-three/drei": "^10.7.6",
        "@react-three/fiber": "^9.3.0",
        "@xyflow/react": "^12.8.4",
        "3d-force-graph": "^1.80.0",
        "chart.js": "^4.5.1",
        "cors": "^2.8.5",
        "cytoscape": "^3.33.3",
        "d3": "^7.9.0",
        "dotenv": "^16.4.7",
        "echarts": "^6.1.0",
        "express": "^4.22.2",
        "force-graph": "^1.51.4",
        "glob": "^13.0.6",
        "helmet": "^8.0.0",
        "ioredis": "^5.11.0",
        "jsdom": "^24.1.3",
        "jszip": "^3.10.1",
        "mammoth": "1.12.0",
        "matter-js": "^0.20.0",
        "mermaid": "10.9.6",
        "openai": "^4.82.0",
        "pdf-lib": "1.17.1",
        "pdfjs-dist": "5.4.624",
        "pdfmake": "^0.2.9",
        "pg": "^8.20.0",
        "phonemize": "^1.2.0",
        "playwright-core": "^1.53.0",
        "plotly.js-dist-min": "^3.5.0",
        "pptxgenjs": "^4.0.1",
        "qrcode": "^1.5.4",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "roughjs": "^4.6.6",
        "sharp": "^0.34.5",
        "three": "^0.184.0",
        "typescript": "^5.7.3",
        "uuid": "^14.0.0",
        "vis-network": "^10.1.0",
        "ws": "^8.21.0",
        "zustand": "^5.0.8"
    },
    "devDependencies": {
        "@types/react": "^19.0.8",
        "@types/react-dom": "^19.0.3",
        "@types/three": "^0.184.0",
        "@vitejs/plugin-react": "^4.3.4",
        "jest": "^29.7.0",
        "nodemon": "^3.1.9",
        "supertest": "^7.0.0",
        "vite": "^6.1.0"
    }
}
