# KimiBuilt Suite online release environment
#
# Copy this file to release.env, then fill the user-provided values below.
# The bundled installer replaces GENERATE_ME_* values with strong random
# secrets and stores the finished file with restricted permissions.

# Package identity
KIMIBUILT_VERSION=1.0.0
KIMIBUILT_IMAGE=ghcr.io/philly1084/kimibuilt:1.0.0
COMPOSE_PROJECT_NAME=kimibuilt-suite

# Public online endpoint
PORT=3000
KIMIBUILT_PUBLIC_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:3000
KIMIBUILT_ALLOWED_ORIGINS=http://localhost:3000

# Browser/API login gate
KIMIBUILT_AUTH_REQUIRED=true
KIMIBUILT_AUTH_USERNAME=admin
KIMIBUILT_AUTH_PASSWORD=GENERATE_ME_48
KIMIBUILT_JWT_SECRET=GENERATE_ME_64
KIMIBUILT_AUTH_COOKIE=kimibuilt_auth
KIMIBUILT_AUTH_TTL_SECONDS=43200

# Server-to-server API token for CLI, websocket, and automation clients
KIMIBUILT_FRONTEND_API_KEY=GENERATE_ME_48
SESSION_SECRET=GENERATE_ME_48

# AI provider setup
# OPENAI_API_KEY is required unless OPENAI_BASE_URL points at a trusted gateway
# that accepts a different bearer key.
OPENAI_API_KEY=replace-with-your-openai-or-gateway-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_API_MODE=auto
OPENAI_REQUEST_TIMEOUT_MS=900000
OPENAI_TOOL_REQUEST_TIMEOUT_MS=900000

# Optional official OpenAI media key for image or video workflows.
OPENAI_MEDIA_API_KEY=
OPENAI_MEDIA_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_MEDIA_IMAGE_MODEL=gpt-image-2
OPENAI_MEDIA_VIDEO_MODEL=sora-2

# Optional research/image search integrations.
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=https://api.perplexity.ai
UNSPLASH_ACCESS_KEY=

# Persistent database and local embedding stack
POSTGRES_DB=kimibuilt
POSTGRES_USER=kimibuilt
POSTGRES_PASSWORD=GENERATE_ME_48
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=conversations
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# Filesystem state inside the compose host
KIMIBUILT_INSTALL_ROOT=/opt/kimibuilt-suite
KIMIBUILT_STATE_ROOT=/var/lib/kimibuilt-suite
KIMIBUILT_DATA_DIR=/home/kimibuilt/.kimibuilt
KIMIBUILT_STATE_DIR=/home/kimibuilt/.kimibuilt

# Docker-backed code and sandbox tools
DOCKER_HOST=tcp://docker-proxy:2375
DOCKER_API_VERSION=1.52

# Remote agent deployment lane. Leave blank until a gateway/runner is online.
REMOTE_CLI_AGENT_TRANSPORT=mcp
REMOTE_CLI_MCP_URL=
REMOTE_CLI_MCP_BEARER_TOKEN=
N8N_API_KEY=
REMOTE_CLI_CODEX_AGENT_BASE_URL=
REMOTE_CLI_CODEX_AGENT_BEARER_TOKEN=
REMOTE_CLI_CODEX_AGENT_WORKSPACE_PATH=/opt/kimibuilt
REMOTE_CLI_CODEX_AGENT_APPROVAL_POLICY=never
REMOTE_CLI_CODEX_AGENT_THREAD_SANDBOX=workspace-write
REMOTE_CLI_TOOL_AUTH_SCOPES=n8n,frontend,admin
REMOTE_CLI_DEFAULT_TARGET_ID=prod
REMOTE_CLI_DEFAULT_CWD=/opt/kimibuilt
REMOTE_CLI_AGENT_MODEL=
REMOTE_CLI_AGENT_OPENAI_API_MODE=chat
REMOTE_CLI_AGENT_MAX_TURNS=20
REMOTE_CLI_AGENT_RUN_TIMEOUT_MS=180000
REMOTE_CLI_AGENT_MAX_STATUS_POLLS=90
REMOTE_CLI_AGENT_STATUS_POLL_INTERVAL_MS=2000
REMOTE_CLI_REMOTE_CODE_MODEL=
KIMIBUILT_REMOTE_RUNNER_TOKEN=GENERATE_ME_48

# Optional SSH defaults for remote-command and k3s-deploy tools
KIMIBUILT_SSH_HOST=
KIMIBUILT_SSH_PORT=22
KIMIBUILT_SSH_USERNAME=
KIMIBUILT_SSH_PASSWORD=
KIMIBUILT_SSH_KEY_PATH=

# TTS/media defaults for the packaged online profile
TTS_PROVIDER=kokoro
TTS_FALLBACK_PROVIDER=none
TTS_FALLBACK_ENABLED=false
KOKORO_TTS_ENABLED=true
KOKORO_TTS_BASE_URL=
KOKORO_TTS_MODEL_ID=onnx-community/Kokoro-82M-v1.0-ONNX
KOKORO_TTS_DEVICE=cpu
KOKORO_TTS_DTYPE=q8
KOKORO_TTS_DEFAULT_VOICE_ID=af_heart
KOKORO_TTS_TIMEOUT_MS=120000
ARTIFACT_BROWSER_PATH=/usr/bin/chromium
PLAYWRIGHT_EXECUTABLE_PATH=/usr/bin/chromium

# Runtime tuning
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=4096
UV_THREADPOOL_SIZE=16
OPENAI_IMAGE_BATCH_CONCURRENCY=4
PODCAST_TTS_CONCURRENCY=2
TOOL_RESULT_CHAR_LIMIT=18000
